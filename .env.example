DATABASE_URL="file:./dev.db"
# Staging/production and the PostgreSQL CI job use the generated schema with:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required in production. Comma-separate additional trusted origins only when
# the same deployment intentionally serves more than one origin.
APP_ORIGIN="https://crm.example.com"

# Required for stable, non-reversible audit IP pseudonyms across multiple app
# instances. Use one secret of at least 32 random characters.
AUDIT_HASH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Required only when loading destructive demo data. No default password exists.
DEMO_SEED_PASSWORD="choose-a-demo-password-of-at-least-12-characters"

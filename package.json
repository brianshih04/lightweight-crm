{
  "name": "lightweight-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/**/*.test.ts",
    "test:security": "node tests/security.integration.mjs",
    "test:postgres": "node tests/postgres.integration.mjs",
    "test:container-smoke": "node tests/container-smoke.mjs",
    "test:e2e": "node scripts/prepare-e2e-database.mjs && cross-env DATABASE_URL=file:./e2e.db RUST_LOG=info prisma db push --skip-generate --schema prisma/schema.prisma && playwright test",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run db:pg:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:security && npm run security:audit",
    "db:push": "prisma db push",
    "db:pg:schema": "node scripts/generate-postgres-schema.mjs",
    "db:pg:check": "node scripts/generate-postgres-schema.mjs --check",
    "db:pg:generate": "npm run db:pg:schema && prisma generate --schema prisma/postgresql/schema.prisma",
    "db:pg:migrate": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:passwords:upgrade": "tsx scripts/upgrade-sqlite-passwords.ts prisma/dev.db",
    "db:pg:import-sqlite": "node scripts/migrate-sqlite-to-postgres.mjs prisma/dev.db",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.19.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.441.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.4.45",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
